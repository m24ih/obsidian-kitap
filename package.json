{
  "name": "obsidian-kitap",
  "version": "0.1.3",
  "description": "Obsidian plugin to search Turkish books from Kitapyurdu and 1000Kitap, enriching notes with quotes, ratings, and metadata.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "kitap",
    "books",
    "kitapyurdu",
    "1000kitap",
    "turkish"
  ],
  "author": "Melih",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.4",
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.5"
  }
}
